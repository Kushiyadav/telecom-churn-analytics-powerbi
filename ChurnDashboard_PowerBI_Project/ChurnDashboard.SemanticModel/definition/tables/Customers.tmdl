table Customers
	lineageTag: c61b7e66-caff-4238-9c86-36221c07bd5a

	measure Customers = COUNTROWS(Customers)
		formatString: #,0
		lineageTag: 33f6a9f2-c50a-4bb7-9204-366baec30187

	measure 'Churned Customers' = CALCULATE([Customers],Customers[Churn_Flag]=1)
		formatString: #,0
		lineageTag: e053cf81-cb76-489e-ac39-2580ce7fcfde

	measure 'Churn Rate' = DIVIDE([Churned Customers],[Customers])
		formatString: 0.0%
		lineageTag: 8453cda8-aedb-4864-8202-e1f36fe62c66

	measure 'Retention Rate' = 1-[Churn Rate]
		formatString: 0.0%
		lineageTag: 5c66e4dd-7d63-4b43-9ad0-81f8ef57aa18

	measure 'Avg Monthly Charge' = AVERAGE(Customers[MonthlyCharges])
		formatString: $#,0.00
		lineageTag: 43f7f1ab-4062-4372-91e4-f48bae7aa00c

	measure 'MRR Lost' = CALCULATE(SUM(Customers[MonthlyCharges]),Customers[Churn_Flag]=1)
		formatString: $#,0
		lineageTag: d00a056e-c1e2-401b-bf52-3eb8bd68e89a

	measure 'Annualized Revenue Lost' = [MRR Lost]*12
		formatString: $#,0
		lineageTag: 6682c498-2171-44cd-b6c1-a0aa4d502654

	measure 'Lifetime Revenue Lost' = CALCULATE(SUM(Customers[TotalCharges]),Customers[Churn_Flag]=1)
		formatString: $#,0
		lineageTag: 65755166-46e7-48a0-838f-2f379a28d1d5

	measure 'Total MRR' = SUM(Customers[MonthlyCharges])
		formatString: $#,0
		lineageTag: d1f67adc-d5e7-4e0c-80ef-ff12e5254ba9

	measure 'MRR at Risk %' = DIVIDE([MRR Lost],[Total MRR])
		formatString: 0.0%
		lineageTag: 47aec1ee-72af-40e1-8130-f240b6786b27

	measure 'Customer Lifetime Value' = DIVIDE(SUM(Customers[TotalCharges]),[Customers])
		formatString: $#,0
		lineageTag: d1319df1-3bce-47c8-96fd-3611e556ce98

	measure 'Monthly Hazard' = DIVIDE([Churned Customers],SUM(Customers[tenure]))
		formatString: 0.00%
		lineageTag: a979a79d-ea5a-4cac-817f-59c84d479b9f

	measure 'Projected CLV (60-mo cap)' = [Avg Monthly Charge]*MIN(DIVIDE(1,[Monthly Hazard]),60)
		formatString: $#,0
		lineageTag: 6277273b-ae9c-4b6d-8270-fc7ff34c788d

	measure 'Share of All Churn' = DIVIDE([Churned Customers],CALCULATE([Churned Customers],ALL(Customers)))
		formatString: 0.0%
		lineageTag: 5f5d584d-cb80-4661-90e6-63faee1b3dae

	measure 'Reduction Selected' = SELECTEDVALUE(ReductionPct[Reduction],0.2)
		formatString: 0%
		lineageTag: b4d0ff73-1c2c-4200-9d4a-ad1ba691bed2

	measure 'Cost Selected' = SELECTEDVALUE(CostPerSave[Cost],120)
		formatString: $#,0
		lineageTag: 011ac825-ad35-4cdd-ba88-50e94056ac20

	measure 'Saved Customers' = [Churned Customers]*[Reduction Selected]
		formatString: #,0
		lineageTag: 09dcd396-37d2-4754-be59-afb62efd1467

	measure 'Annual Revenue Kept' = [MRR Lost]*12*[Reduction Selected]
		formatString: $#,0
		lineageTag: 7ecddb3b-98e5-4d94-aeca-1c3f63b5797f

	measure 'Program Cost' = [Saved Customers]*[Cost Selected]
		formatString: $#,0
		lineageTag: e2895a31-6fcd-4f9d-9df9-acfe9672b69e

	measure 'Net Benefit (Yr 1)' = [Annual Revenue Kept]-[Program Cost]
		formatString: $#,0
		lineageTag: e29e6943-e36f-407c-9163-d5176c125aea

	measure 'New Churn Rate' = DIVIDE([Churned Customers]-[Saved Customers],[Customers])
		formatString: 0.0%
		lineageTag: 292a1b39-bc78-4577-bd53-8ba313fc8095

